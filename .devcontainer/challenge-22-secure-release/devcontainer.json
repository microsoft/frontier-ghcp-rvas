{
	"name": "Challenge 22 - Secure Release Review",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	"features": {
		"ghcr.io/devcontainers/features/dotnet:2": {
			"version": "8.0"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"ms-dotnettools.csdevkit",
				"redhat.vscode-yaml"
			]
		}
	},
	"postCreateCommand": "bash scripts/setup-challenge.sh challenge-22-secure-release && dotnet restore challenges/challenge-22-secure-release/SecureReleaseReview.sln",
	"remoteUser": "vscode"
}
